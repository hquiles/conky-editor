{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": "dist",
    "noEmit": false,
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true
  },
  "include": ["src/main/**/*"]
}
